DATABASE_URL=postgres://user:password@localhost:5432/esports_hub
PANDASCORE_API_KEY=
RIOT_API_KEY=

# Quantas páginas de 100 registros puxar por recurso/jogo (default: 3).
# Aumente para backfill, mantenha baixo para sync rápida.
PANDASCORE_MAX_PAGES=3

# Spectator-V4 foi descontinuada pela Riot; o default v5 recebe puuid.
# RIOT_SPECTATOR_VERSION=v4

# Caminho alternativo para a lista de jogadores rastreados.
# RIOT_TRACKED_PLAYERS_PATH=worker/tracked-players.json
